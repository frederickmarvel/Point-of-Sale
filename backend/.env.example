# Server
PORT=3000
NODE_ENV=development

# Database - SQLite
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Xendit Payment Gateway
# Get your API key from https://dashboard.xendit.co/settings/developers#api-keys
XENDIT_SECRET_KEY=xnd_development_XXXXXXXXXX
XENDIT_WEBHOOK_TOKEN=your-xendit-webhook-token
XENDIT_SUCCESS_URL=http://localhost:5173/payment/success
XENDIT_FAILURE_URL=http://localhost:5173/payment/failure

# Durianpay Payment Gateway
# Get your API key from https://dashboard.durianpay.id/settings/developers
DURIANPAY_SECRET_KEY=dp_test_XXXXXXXXXX
DURIANPAY_SUCCESS_URL=http://localhost:5173/payment/success
DURIANPAY_FAILURE_URL=http://localhost:5173/payment/failure

# Default payment gateway: XENDIT or DURIANPAY
DEFAULT_PAYMENT_GATEWAY=XENDIT

# QR Code base URL (public-facing URL for customer ordering)
QR_BASE_URL=http://localhost:5173
